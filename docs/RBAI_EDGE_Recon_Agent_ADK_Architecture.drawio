        <mxCell id="tlm" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#0B55C0;fillColor=#F4F8FF;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;TLM Cairo / Kafka&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;EOD / intraday break event&lt;br&gt;Sole authoritative exception source&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="300" x="175" y="115" as="geometry" />
        </mxCell>
        <mxCell id="analyst" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#0B55C0;fillColor=#F4F8FF;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;Analyst / EDGE Workbench&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Interactive investigation&lt;br&gt;Ad-hoc questions / complex breaks&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="300" x="520" y="115" as="geometry" />
        </mxCell>
        <mxCell id="human" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#0B55C0;fillColor=#F4F8FF;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;Human Review / Approval Queue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Approve • edit • reject • override&lt;br&gt;SETTS Recon / StockLoan MO / Tech / GRU&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="355" x="865" y="115" as="geometry" />
        </mxCell>
        <mxCell id="policy" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#C2410C;fillColor=#FFF7ED;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;Policy &amp;amp; Configuration&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;decision_tree.yaml • thresholds • output schemas&lt;br&gt;execution whitelist • queue routing • guardrails&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="400" x="1265" y="115" as="geometry" />
        </mxCell>
        <mxCell id="primary_badge" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#166534;fillColor=#F3FBF3;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;PRIMARY PRODUCTION PATH — deterministic stage order&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Predictable, testable, auditable; LLM used only inside explicitly bounded stages.&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="950" x="175" y="215" as="geometry" />
        </mxCell>
        <mxCell id="auto_badge" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#6D28D9;fillColor=#F8F5FF;fontColor=#111827;strokeWidth=2;" value="&lt;b&gt;BOUNDED AUTONOMY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Only for unmatched / ambiguous / analyst-initiated investigation. No direct write execution.&lt;/font&gt;" vertex="1">
          <mxGeometry height="48" width="510" x="1155" y="215" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#166534;fillColor=#F3FBF3;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;1. Exception Ingestion&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CustomAgent — deterministic&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Read TLM exception + prior narration&lt;br&gt;• Normalize account / ISIN / quantity / amount / counterparty / dates&lt;br&gt;• Seed session state &amp;amp; correlation IDs&lt;br&gt;• Write “investigation commenced” event&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;&lt;b&gt;Why:&lt;/b&gt; no judgment required; exact reproducibility.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="245" x="170" y="300" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#6D28D9;fillColor=#F8F5FF;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;2. Path Identification&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LlmAgent + output_schema&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Match break to configured decision-tree path&lt;br&gt;• Return path_id + match + confidence&lt;br&gt;• Never invent new operational policy&lt;br&gt;• Unmatched / weak match → complex-break path&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;&lt;b&gt;Why LLM:&lt;/b&gt; semantic classification across heterogeneous exception text.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="245" x="430" y="300" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#166534;fillColor=#F3FBF3;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;3. Right-Side Population&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ParallelAgent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Child source-family agents:&lt;br&gt;• settlement_sources_agent&lt;br&gt;• stockrecord_sources_agent&lt;br&gt;• books_records_sources_agent&lt;br&gt;• external_sources_agent&lt;br&gt;&lt;br&gt;Each child is deterministic and writes its own state slice.&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;&lt;b&gt;Why parallel:&lt;/b&gt; independent reads; meet per-source latency budget.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="270" x="690" y="300" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#166534;fillColor=#F3FBF3;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;4. Root-Cause Analysis&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Custom + LLM narrative + validator&lt;/b&gt;&lt;br&gt;&lt;br&gt;• root_cause_analysis_agent — deterministic comparisons / rules&lt;br&gt;• root_cause_narrative_agent — explain facts in analyst language&lt;br&gt;• analysis_validation_agent — completeness, contradictions, policy, composite score&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;&lt;b&gt;Boundary:&lt;/b&gt; model narrates; code establishes facts.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="290" x="975" y="300" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#C2410C;fillColor=#FFF7ED;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;5. Resolution Review&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;LoopAgent (bounded iterations)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• resolution_proposal_agent — proposed action + draft narration&lt;br&gt;• proposal_validation_agent — deterministic policy checks&lt;br&gt;• human_review_resolution_agent — approve / edit / reject&lt;br&gt;• Edits re-enter validation before approval&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;&lt;b&gt;Gate:&lt;/b&gt; confidence does not grant permission; policy does.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="245" x="1280" y="300" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#166534;fillColor=#F3FBF3;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;6. Resolution Execution&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;SequentialAgent — deterministic&lt;/b&gt;&lt;br&gt;&lt;br&gt;• target_system_execution_agent&lt;br&gt;• tlm_narration_agent&lt;br&gt;• tlm_automatch_agent&lt;br&gt;• review_tags_agent&lt;br&gt;• Idempotency + execution reference + immutable audit&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;&lt;b&gt;Why:&lt;/b&gt; ordered side effects must be safe and repeatable.&lt;/font&gt;" vertex="1">
          <mxGeometry height="265" width="245" x="1540" y="300" as="geometry" />
        </mxCell>
        <mxCell id="autonomous" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=12;fontSize=13;strokeColor=#6D28D9;fillColor=#F8F5FF;fontColor=#111827;strokeWidth=2;" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Autonomous Complex-Break Investigation Agent&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Bounded LLM agent / agentic loop&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Observe → form hypothesis → select approved read tools → gather evidence → reflect → revise → propose / escalate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use when: no configured path matches; evidence conflicts; a new break pattern appears; analyst asks an ad-hoc investigative question.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;&lt;b&gt;Hard boundary:&lt;/b&gt; read-only tools by default; cannot bypass policy, HITL, or Stage 6 execution controls. Returns an evidence-backed proposal to Stage 5.&lt;/font&gt;" vertex="1">
          <mxGeometry height="220" width="690" x="430" y="620" as="geometry" />
        </mxCell>
        <mxCell id="why_both" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=10;fontSize=13;strokeColor=#94A3B8;fillColor=#F8FAFC;fontColor=#111827;strokeWidth=1.5;" value="&lt;font style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Why use both deterministic and autonomous patterns?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;td width=&quot;48%&quot;&gt;&lt;b&gt;&lt;font color=&quot;#166534&quot;&gt;Deterministic path&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Known reconciliation patterns&lt;br&gt;• Stable stage ordering&lt;br&gt;• Regulatory traceability&lt;br&gt;• Lower cost / latency&lt;br&gt;• Repeatable tests &amp;amp; controls&lt;br&gt;• Safe writes / idempotency&lt;/td&gt;&lt;td width=&quot;4%&quot;&gt;&lt;/td&gt;&lt;td width=&quot;48%&quot;&gt;&lt;b&gt;&lt;font color=&quot;#6D28D9&quot;&gt;Autonomous path&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Novel / ambiguous breaks&lt;br&gt;• Dynamic evidence discovery&lt;br&gt;• Hypothesis exploration&lt;br&gt;• Contradictory evidence&lt;br&gt;• Analyst-led investigation&lt;br&gt;• Extends coverage without weakening execution controls&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="220" width="635" x="1150" y="620" as="geometry" />
        </mxCell>
        <mxCell id="tool_tlm" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=10;fontSize=13;strokeColor=#0F766E;fillColor=#FFFFFF;fontColor=#0F172A;strokeWidth=1.5;" value="&lt;b&gt;TLM Cairo MCP&lt;/b&gt;&lt;br&gt;get_tlm_exception&lt;br&gt;get_tlm_narrations&lt;br&gt;write_tlm_narration / auto-match" vertex="1">
          <mxGeometry height="115" width="355" x="170" y="900" as="geometry" />
        </mxCell>
        <mxCell id="tool_right" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=10;fontSize=13;strokeColor=#0F766E;fillColor=#FFFFFF;fontColor=#0F172A;strokeWidth=1.5;" value="&lt;b&gt;Right-Side Read Tools&lt;/b&gt;&lt;br&gt;Settlement • ATM/ManTran • IGSR • Stock Record&lt;br&gt;Stock Loan • Full Suite / FlexCube • External / SSI" vertex="1">
          <mxGeometry height="115" width="410" x="550" y="900" as="geometry" />
        </mxCell>
        <mxCell id="tool_target" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=10;fontSize=13;strokeColor=#0F766E;fillColor=#FFFFFF;fontColor=#0F172A;strokeWidth=1.5;" value="&lt;b&gt;Target-System Write Tools&lt;/b&gt;&lt;br&gt;Whitelisted actions only&lt;br&gt;Execution result + reference + idempotency key" vertex="1">
          <mxGeometry height="115" width="350" x="985" y="900" as="geometry" />
        </mxCell>
        <mxCell id="tool_state" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=10;fontSize=13;strokeColor=#0F766E;fillColor=#FFFFFF;fontColor=#0F172A;strokeWidth=1.5;" value="&lt;b&gt;State / Audit / Observability&lt;/b&gt;&lt;br&gt;DatabaseSessionService (PostgreSQL)&lt;br&gt;AgentEvent / AgentReviewTask • metrics / traces / guardrails" vertex="1">
          <mxGeometry height="115" width="425" x="1360" y="900" as="geometry" />
