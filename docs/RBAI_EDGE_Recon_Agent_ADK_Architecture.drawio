        <mxCell id="lane_tools" parent="1" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=12;fontSize=16;strokeColor=#0F766E;fillColor=#F2FCFC;fontColor=#0B1B4D;strokeWidth=2;" value="&lt;b&gt;MCP Tools / APIs&lt;br&gt;&amp;amp; State&lt;/b&gt;" vertex="1">
