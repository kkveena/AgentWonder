        </mxCell>
        <mxCell id="e_s6_target" edge="1" parent="1" source="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#64748B;dashed=1;dashPattern=6 5;fontSize=11;fontFamily=Arial;" target="tool_target" value="controlled writes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_s6_tlm" edge="1" parent="1" source="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#64748B;dashed=1;dashPattern=6 5;fontSize=11;fontFamily=Arial;" target="tool_tlm" value="narration / auto-match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_state_s1" edge="1" parent="1" source="tool_state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#64748B;dashed=1;dashPattern=6 5;fontSize=11;fontFamily=Arial;" target="s1" value="session state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_state_s5" edge="1" parent="1" source="tool_state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#64748B;dashed=1;dashPattern=6 5;fontSize=11;fontFamily=Arial;" target="s5" value="review task / audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_state_s6" edge="1" parent="1" source="tool_state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#64748B;dashed=1;dashPattern=6 5;fontSize=11;fontFamily=Arial;" target="s6" value="execution audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Agent Catalog &amp; ADK Mapping" id="1">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="&lt;b&gt;RBAI/EDGE — Agent Catalog &amp;amp; ADK Mapping&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=30;fontColor=#0B1B4D;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="18" width="1440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="&lt;i&gt;High-level responsibilities, contracts and rationale for each agent primitive&lt;/i&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="330" y="62" width="1140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;Stage / Agent&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#FFFFFF;strokeColor=#0B1B4D;fillColor=#0B1B4D;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;ADK Primitive&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#FFFFFF;strokeColor=#0B1B4D;fillColor=#0B1B4D;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="240" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="&lt;b&gt;High-Level Responsibility&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#FFFFFF;strokeColor=#0B1B4D;fillColor=#0B1B4D;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="500" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="&lt;b&gt;Primary State / Output&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#FFFFFF;strokeColor=#0B1B4D;fillColor=#0B1B4D;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="330" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="&lt;b&gt;Why This Pattern&lt;/b&gt;" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#FFFFFF;strokeColor=#0B1B4D;fillColor=#0B1B4D;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="120" width="320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r0a" value="Workflow Root / Entry Router" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="168" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r0b" value="SequentialAgent / custom workflow runner" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="168" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r0c" value="Event-driven production flow fixes stage order. Interactive analyst entry can invoke the same underlying investigation services." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="600" y="168" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r0d" value="event_type, run_type, settle_date, tlm_refs, session metadata" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1100" y="168" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r0e" value="Do not spend an LLM call deciding a workflow that is already known. Predictability and auditability first." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1430" y="168" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1a" value="1 — exception_ingestion_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="272" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="CustomAgent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="272" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1c" value="Fetch TLM exception and prior narration; normalize break attributes; initialize state; establish correlation / audit context." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="600" y="272" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1d" value="break_records; event context; initial narration" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1100" y="272" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r1e" value="Pure data movement / normalization. Deterministic code is cheaper, faster and testable." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1430" y="272" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r2a" value="2 — path_identification_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="376" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r2b" value="LlmAgent + output_schema" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="376" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r2c" value="Semantically match a break to one of the configured decision-tree paths. Return only schema-valid path_id / match / confidence." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="600" y="376" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r2d" value="path_selection" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="1100" y="376" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r2e" value="LLM handles heterogeneous language well, but policy remains configuration. Unmatched breaks cannot be invented into a new path." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="1430" y="376" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r3a" value="3 — rightside_population_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="ParallelAgent + CustomAgent children" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r3c" value="Fan out by source family. Each child calls only its approved MCP read tools and writes an independent evidence slice; one failed source degrades one slice, not the entire run." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="600" y="480" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r3d" value="positions_data.&lt;family&gt;; source_status; latency" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1100" y="480" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r3e" value="Concurrency is useful for independent I/O and helps satisfy the right-side latency budget without multiplying LLM calls." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1430" y="480" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r4a" value="4 — root_cause_analysis_agent + root_cause_narrative_agent + analysis_validation_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="584" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value="CustomAgent + LlmAgent + CustomAgent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="584" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r4c" value="Compute root cause deterministically; generate analyst-readable narrative from established facts; validate source completeness, contradictions, rule satisfaction and composite confidence." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="600" y="584" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r4d" value="investigation_report; investigation_narrative; analysis_validation" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1100" y="584" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r4e" value="Separate “establish facts” from “explain facts.” The model must not become the accounting / reconciliation engine." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1430" y="584" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r5a" value="5 — loop_resolution_review_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="688" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r5b" value="LoopAgent + LlmAgent + CustomAgent + HumanReviewAgent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="688" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r5c" value="Create a resolution proposal and draft narration; validate against policy; route to analyst; edited proposals loop through validation again before approval." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#FFF7ED;strokeColor=#C2410C;" vertex="1" parent="1">
          <mxGeometry x="600" y="688" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r5d" value="resolution_proposal; review_task_id; review decision" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#FFF7ED;strokeColor=#C2410C;" vertex="1" parent="1">
          <mxGeometry x="1100" y="688" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r5e" value="A bounded loop models propose → validate → review → revise. Human review remains the control point for non-auto paths." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#FFF7ED;strokeColor=#C2410C;" vertex="1" parent="1">
          <mxGeometry x="1430" y="688" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r6a" value="6 — resolution_execution_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="792" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r6b" value="SequentialAgent + CustomAgent children" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="792" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r6c" value="Execute whitelisted target-system action, verify result, write standard TLM narration, auto-match where allowed, tag review/audit records." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="600" y="792" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r6d" value="execution_result; narration_result; match_result; execution_ref" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1100" y="792" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r6e" value="Side effects need strict ordering, idempotency and deterministic success criteria. No free-form autonomous execution." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F3FBF3;strokeColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1430" y="792" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r7a" value="Complex Break — autonomous_investigation_agent" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="896" width="300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r7b" value="Bounded LLM agent / agentic loop" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="896" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r7c" value="Explore novel or ambiguous breaks using approved read tools: form hypotheses, gather evidence, compare alternatives, and return an evidence-backed proposal or escalation." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="600" y="896" width="500" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r7d" value="hypotheses; evidence trail; proposed path/action; escalation reason" style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="1100" y="896" width="330" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r7e" value="Autonomy adds coverage where a static tree is insufficient, while execution remains behind Stage 5/6 controls." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#111827;strokeWidth=1;fillColor=#F8F5FF;strokeColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="1430" y="896" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="footer2" value="&lt;b&gt;Design rule:&lt;/b&gt; autonomy is allowed to &lt;i&gt;reason, search, compare and propose&lt;/i&gt;; only deterministic policy-controlled agents may &lt;i&gt;approve eligibility, mutate target systems, auto-match or close a break&lt;/i&gt;." style="fontFamily=Arial;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=1;arcSize=10;fontSize=14;fontColor=#0B1B4D;strokeColor=#C2410C;fillColor=#FFF7ED;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="1690" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
