        <mxCell id="e12" value="LEARN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5E6A76;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prod_gate" target="p4n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="802"/><mxPoint x="365" y="802"/></Array></mxGeometry></mxCell>
