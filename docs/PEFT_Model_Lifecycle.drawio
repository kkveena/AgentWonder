          <mxGeometry x="60" y="24" width="920" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Governed path from curated historical data to monitored production learning" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#5E6A76;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="64" width="820" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="metric1" value="12K curated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#E8F0F8;strokeColor=#2E74B5;fontColor=#0B2545;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="945" y="30" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="metric2" value="10K train" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#E5F3F1;strokeColor=#2B7A78;fontColor=#0B2545;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="30" width="100" height="34" as="geometry"/></mxCell>
        <mxCell id="metric3" value="2K holdout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#E5F3F1;strokeColor=#2B7A78;fontColor=#0B2545;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="30" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="metric4" value="90d / 5K trigger" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F4F7;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1285" y="30" width="125" height="34" as="geometry"/></mxCell>
        <mxCell id="metric5" value="1K human review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#F2F4F7;strokeColor=#0B2545;fontColor=#0B2545;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="30" width="125" height="34" as="geometry"/></mxCell>
        <mxCell id="assumption_note" value="Working quantities for manager confirmation" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#5E6A76;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1080" y="66" width="465" height="24" as="geometry"/></mxCell>

        <!-- Phase 1 -->
        <mxCell id="lane1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F5F9FD;strokeColor=#2E74B5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="115" width="1460" height="195" as="geometry"/></mxCell>
        <mxCell id="lane1_header" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F0F8;strokeColor=#2E74B5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="115" width="1460" height="55" as="geometry"/></mxCell>
        <mxCell id="phase1_badge" value="PHASE 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#2E74B5;strokeColor=#2E74B5;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="126" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="phase1_title" value="DATA PREPARATION AND CURATION  |  Outcome: trustworthy training and evaluation data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0B2545;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215" y="124" width="930" height="38" as="geometry"/></mxCell>
        <mxCell id="p1n1" value="&lt;b&gt;STEPS 1-2&lt;/b&gt;&lt;br&gt;Review taxonomy and collect three months of labeled history&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Positive + human-corrected negative examples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E74B5;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="245" y="195" width="330" height="88" as="geometry"/></mxCell>
        <mxCell id="p1n2" value="&lt;b&gt;STEP 3&lt;/b&gt;&lt;br&gt;Create a balanced dataset of approximately 12,000 examples&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Target at least 500 examples per class&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E74B5;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="635" y="195" width="330" height="88" as="geometry"/></mxCell>
        <mxCell id="p1n3" value="&lt;b&gt;STEPS 4-5&lt;/b&gt;&lt;br&gt;Semantic deduplication, human QA and data-quality gate&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Validate 200 duplicate pairs + stratified review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E74B5;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1025" y="195" width="330" height="88" as="geometry"/></mxCell>

        <!-- Phase 2 -->
        <mxCell id="lane2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F3FAF9;strokeColor=#2B7A78;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="1460" height="215" as="geometry"/></mxCell>
        <mxCell id="lane2_header" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E5F3F1;strokeColor=#2B7A78;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="1460" height="55" as="geometry"/></mxCell>
        <mxCell id="phase2_badge" value="PHASE 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#2B7A78;strokeColor=#2B7A78;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="346" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="phase2_title" value="PEFT TRAINING AND OFFLINE EVALUATION  |  Outcome: versioned adapter with reproducible evidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0B2545;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215" y="344" width="930" height="38" as="geometry"/></mxCell>
        <mxCell id="p2n1" value="&lt;b&gt;STEP 6&lt;/b&gt;&lt;br&gt;Generate and validate teacher-model rationales&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Automated checks + AI judge + targeted HIL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B7A78;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="180" y="415" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="p2n2" value="&lt;b&gt;STEP 7&lt;/b&gt;&lt;br&gt;Lock the 2,000-example golden evaluation set&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;No training leakage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B7A78;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="415" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="p2n3" value="&lt;b&gt;STEP 8&lt;/b&gt;&lt;br&gt;Fine-tune on approximately 10,000 examples&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Frozen backbone; LoRA / QLoRA adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B7A78;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="415" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="p2n4" value="&lt;b&gt;STEP 9&lt;/b&gt;&lt;br&gt;Offline evaluation against base-model and RAG baselines&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Precision, recall, micro/macro F1, errors, latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B7A78;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="415" width="255" height="92" as="geometry"/></mxCell>
        <mxCell id="release_gate" value="RELEASE&lt;br&gt;GATE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B7A78;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="420" width="90" height="82" as="geometry"/></mxCell>

        <!-- Phase 3 -->
        <mxCell id="lane3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF9EC;strokeColor=#B98418;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="575" width="1460" height="215" as="geometry"/></mxCell>
        <mxCell id="lane3_header" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FAF1DC;strokeColor=#B98418;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="575" width="1460" height="55" as="geometry"/></mxCell>
        <mxCell id="phase3_badge" value="PHASE 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#B98418;strokeColor=#B98418;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="586" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="phase3_title" value="CONTROLLED LAUNCH AND ONLINE EVALUATION  |  Outcome: observable production model with safe fallback" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0B2545;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215" y="584" width="1000" height="38" as="geometry"/></mxCell>
        <mxCell id="p3n1" value="&lt;b&gt;STEP 10&lt;/b&gt;&lt;br&gt;Optimize, register and launch through canary / phased rollout&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Version all artifacts and preserve rollback path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B98418;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="655" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="p3n2" value="&lt;b&gt;STEP 11&lt;/b&gt;&lt;br&gt;Maintain RAG as benchmark, challenger or governed fallback&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Retrieve comparable historical examples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B98418;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="655" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="p3n3" value="&lt;b&gt;STEP 12&lt;/b&gt;&lt;br&gt;Monitored online evaluation with frontier challenger&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Judge disagreements; escalate high-risk cases to humans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B98418;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="655" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="prod_gate" value="PROMOTE&lt;br&gt;HOLD&lt;br&gt;ROLL BACK" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B98418;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="648" width="140" height="106" as="geometry"/></mxCell>

        <!-- Phase 4 -->
        <mxCell id="lane4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F6F7FA;strokeColor=#0B2545;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="815" width="1460" height="215" as="geometry"/></mxCell>
        <mxCell id="lane4_header" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F2F4F7;strokeColor=#0B2545;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="815" width="1460" height="55" as="geometry"/></mxCell>
        <mxCell id="phase4_badge" value="PHASE 4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#0B2545;strokeColor=#0B2545;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="826" width="105" height="34" as="geometry"/></mxCell>
        <mxCell id="phase4_title" value="CONTINUOUS TRAINING AND PROMOTION  |  Outcome: demonstrated gain without unacceptable forgetting" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#0B2545;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="215" y="824" width="1000" height="38" as="geometry"/></mxCell>
        <mxCell id="p4n1" value="&lt;b&gt;STEP 13&lt;/b&gt;&lt;br&gt;Detect drift and trigger the next cycle&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Approximately 90 days or 5,000 new samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#0B2545;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="895" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="p4n2" value="&lt;b&gt;STEP 14&lt;/b&gt;&lt;br&gt;Select approximately 1,000 high-value cases for human review&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Prioritize uncertainty, disagreements and high-impact errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#0B2545;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="895" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="p4n3" value="&lt;b&gt;STEP 15&lt;/b&gt;&lt;br&gt;Retrain and regression-test the original golden set&lt;br&gt;&lt;font color=&quot;#5E6A76&quot;&gt;Compare challenger with current production adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#0B2545;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="895" width="290" height="92" as="geometry"/></mxCell>
        <mxCell id="retrain_gate" value="PROMOTE NEW&lt;br&gt;ADAPTER?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2545;strokeWidth=2;fontColor=#0B2545;fontFamily=Arial;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="895" width="140" height="92" as="geometry"/></mxCell>

